{$SITE_ADDRESS:localhost} {
	encode gzip

	handle /api/* {
		reverse_proxy backend:4000
	}

	handle /uploads/* {
		reverse_proxy backend:4000
	}

	# phpMyAdmin subpath routing
	redir /phpmyadmin /phpmyadmin/
	handle_path /phpmyadmin/* {
		reverse_proxy phpmyadmin:80
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

