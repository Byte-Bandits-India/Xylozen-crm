{$SITE_ADDRESS:crm.thebytebandits.com} {
	encode gzip

	# Backend API
	handle /api/* {
		reverse_proxy backend:4000
	}

	# Uploaded media and attachments
	handle /uploads/* {
		reverse_proxy backend:4000
	}

	# phpMyAdmin database management
	redir /phpmyadmin /phpmyadmin/
	handle_path /phpmyadmin/* {
		reverse_proxy phpmyadmin:80
	}

	# Default fallback for API gateway
	handle {
		respond "CRM API Gateway Active" 200
	}
}
