# ==========================================
# PRODUCTION: crm.xylozentech.com
# ==========================================
crm.xylozentech.com {
	encode gzip

	# Production Backend API
	handle /api/* {
		reverse_proxy backend-prod:4000
	}

	# Production Uploaded media and attachments
	handle /uploads/* {
		reverse_proxy backend-prod:4000
	}

	# phpMyAdmin database management
	redir /phpmyadmin /phpmyadmin/
	handle_path /phpmyadmin/* {
		reverse_proxy phpmyadmin:80
	}

	# Production Frontend SPA
	handle {
		reverse_proxy frontend-prod:80
	}
}

# ==========================================
# TEST: testcrm.xylozentech.com
# ==========================================
testcrm.xylozentech.com {
	encode gzip

	# Test Backend API
	handle /api/* {
		reverse_proxy backend-test:4000
	}

	# Test Uploaded media and attachments
	handle /uploads/* {
		reverse_proxy backend-test:4000
	}

	# Test Frontend SPA
	handle {
		reverse_proxy frontend-test:80
	}
}

# ==========================================
# MAIN WEBSITE: xylozentech.com
# ==========================================
xylozentech.com, www.xylozentech.com {
	encode gzip zstd

	reverse_proxy xylozen-app:3000

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
}

