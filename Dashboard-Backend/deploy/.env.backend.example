# Copy this file to .env.backend on the server (same directory as
# docker-compose.yml) and fill in real values. This file stays on the
# server only — it is never committed or built into the image.

# MySQL runs on the host, so use host.docker.internal, not localhost.
DATABASE_URL=mysql://user:password@host.docker.internal:3306/dashboard

JWT_SECRET=
JWT_REFRESH_SECRET=
PORT=4000
NODE_ENV=production

SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
OWNER_EMAIL=
APP_URL=https://crm.thebytebandits.com

FRONTEND_URL=https://crm.thebytebandits.com
ALLOWED_ORIGINS=

GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
