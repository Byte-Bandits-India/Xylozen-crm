# Production Environment Configuration: .env.backend.prod
# Place this file as .env.backend.prod in /home/ec2-user/dashboard on the EC2 server.
# This file stays on the server only and is NEVER committed to git.

# Production Database (MySQL on EC2 host)
DATABASE_URL=mysql://dashboard_user:YOUR_PROD_DB_PASSWORD@host.docker.internal:3306/dashboard_prod

JWT_SECRET=YOUR_PRODUCTION_JWT_SECRET
JWT_REFRESH_SECRET=YOUR_PRODUCTION_JWT_REFRESH_SECRET
PORT=4000
NODE_ENV=production

# Email SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@xylozentech.com
SMTP_PASS=YOUR_APP_PASSWORD
SMTP_FROM="Xylozen Technologies <support@xylozentech.com>"
OWNER_EMAIL=support@xylozentech.com

# Production Domain URLs
APP_URL=https://crm.xylozentech.com
FRONTEND_URL=https://crm.xylozentech.com
ALLOWED_ORIGINS=https://crm.xylozentech.com

# Google Drive API (Optional)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
