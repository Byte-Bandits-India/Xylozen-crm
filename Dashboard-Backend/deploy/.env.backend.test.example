# Test Environment Configuration: .env.backend.test
# Place this file as .env.backend.test in /home/ec2-user/dashboard on the EC2 server.
# This file stays on the server only and is NEVER committed to git.

# Test Database (MySQL on EC2 host)
DATABASE_URL=mysql://dashboard_user:YOUR_TEST_DB_PASSWORD@host.docker.internal:3306/dashboard_test

JWT_SECRET=YOUR_TEST_JWT_SECRET
JWT_REFRESH_SECRET=YOUR_TEST_JWT_REFRESH_SECRET
PORT=4000
NODE_ENV=production

# Email SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@xylozentech.com
SMTP_PASS=YOUR_APP_PASSWORD
SMTP_FROM="Xylozen Technologies (Test) <support@xylozentech.com>"
OWNER_EMAIL=support@xylozentech.com

# Test Domain URLs
APP_URL=https://testcrm.xylozentech.com
FRONTEND_URL=https://testcrm.xylozentech.com
ALLOWED_ORIGINS=https://testcrm.xylozentech.com

